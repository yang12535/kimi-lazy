{
  "manifest_version": 3,
  "name": "Kimi 会话轻量浏览",
  "version": "0.1.1",
  "description": "Kimi Web 会话按需渲染：最近消息、按需恢复、闲置回收和工具过程懒渲染；仅对已核对的前端构建启用。",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "policy.js",
        "main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "panel.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
